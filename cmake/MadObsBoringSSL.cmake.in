# Relocatable binary provider. Integrity check is not a source/signature attestation.
get_filename_component(_madobs_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
set(_madobs_crypto "${_madobs_prefix}/lib/madobs/libmadobs_boringssl_crypto.a")
if(NOT EXISTS "${_madobs_crypto}")
  message(FATAL_ERROR "MadObs bundled BoringSSL archive is missing")
endif()
file(SHA256 "${_madobs_crypto}" _madobs_crypto_actual)
if(NOT _madobs_crypto_actual STREQUAL "@MADOBS_PROVIDER_ARCHIVE_SHA256@")
  message(FATAL_ERROR "MadObs bundled BoringSSL integrity check failed")
endif()
find_dependency(Threads)
if(TARGET MadObs::BoringSSL)
  get_target_property(_madobs_existing MadObs::BoringSSL IMPORTED_LOCATION)
  if(NOT _madobs_existing STREQUAL _madobs_crypto)
    message(FATAL_ERROR "Conflicting MadObs::BoringSSL provider target")
  endif()
else()
  add_library(MadObs::BoringSSL STATIC IMPORTED)
  set_target_properties(MadObs::BoringSSL PROPERTIES
    IMPORTED_LOCATION "${_madobs_crypto}"
    INTERFACE_LINK_LIBRARIES Threads::Threads)
endif()
unset(_madobs_prefix)
unset(_madobs_crypto)
unset(_madobs_crypto_actual)
