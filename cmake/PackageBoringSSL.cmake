set(MADOBS_BORINGSSL_SOURCE_ARCHIVE "" CACHE FILEPATH "Pinned BoringSSL source tarball for offline verification")
if(NOT MADOBS_PACKAGE_BORINGSSL)
  install(CODE "message(FATAL_ERROR \"BoringSSL native package requires MADOBS_PACKAGE_BORINGSSL=ON and verified source archive; no absolute-path provider export is allowed\")")
else()
  find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
  get_filename_component(_madobs_bssl_source "${MADOBS_PROVIDER_INCLUDE}" DIRECTORY)
  execute_process(COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/scripts/verify-boringssl-source.py"
    --archive "${MADOBS_BORINGSSL_SOURCE_ARCHIVE}" --source "${_madobs_bssl_source}"
    RESULT_VARIABLE _madobs_verify_result OUTPUT_VARIABLE _madobs_source_evidence ERROR_VARIABLE _madobs_verify_error)
  if(NOT _madobs_verify_result EQUAL 0)
    message(FATAL_ERROR "BoringSSL source verification failed: ${_madobs_verify_error}")
  endif()
  file(SHA256 "${MADOBS_PROVIDER_LIBRARY}" MADOBS_PROVIDER_ARCHIVE_SHA256)
  configure_file(cmake/MadObsBoringSSL.cmake.in "${CMAKE_CURRENT_BINARY_DIR}/MadObsBoringSSL.cmake" @ONLY)
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/boringssl-source-evidence.json" "${_madobs_source_evidence}")
  file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/boringssl-binary-evidence.json"
    "{\n  \"archive_sha256\": \"${MADOBS_PROVIDER_ARCHIVE_SHA256}\",\n  \"madobs_cxx_compiler_id\": \"${CMAKE_CXX_COMPILER_ID}\",\n  \"madobs_cxx_compiler_version\": \"${CMAKE_CXX_COMPILER_VERSION}\",\n  \"system\": \"${CMAKE_SYSTEM_NAME}\",\n  \"processor\": \"${CMAKE_SYSTEM_PROCESSOR}\",\n  \"scope\": \"Artifact identity only; not a reproducible-build or full SBOM attestation\"\n}\n")
  install(FILES "${MADOBS_PROVIDER_LIBRARY}" DESTINATION lib/madobs RENAME libmadobs_boringssl_crypto.a)
  install(FILES "${CMAKE_CURRENT_BINARY_DIR}/MadObsBoringSSL.cmake" DESTINATION lib/cmake/MadObs)
  install(FILES "${_madobs_bssl_source}/LICENSE" DESTINATION share/MadObs/licenses RENAME BoringSSL-LICENSE)
  install(FILES "${_madobs_bssl_source}/third_party/fiat/LICENSE" DESTINATION share/MadObs/licenses RENAME Fiat-LICENSE)
  install(FILES "${_madobs_bssl_source}/third_party/fiat/AUTHORS" DESTINATION share/MadObs/licenses RENAME Fiat-AUTHORS)
  install(FILES deps/boringssl.lock.json "${CMAKE_CURRENT_BINARY_DIR}/boringssl-source-evidence.json" "${CMAKE_CURRENT_BINARY_DIR}/boringssl-binary-evidence.json" DESTINATION share/MadObs/deps)
endif()
